{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Orchestrio Workflow Spec v1",
  "description": "Language-agnostic workflow definition schema. Any executor (Python, Go, etc.) must accept this format.",
  "type": "object",
  "required": ["name", "steps"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Unique workflow name"
    },
    "version": {
      "type": "string",
      "description": "Workflow spec version",
      "default": "1"
    },
    "description": {
      "type": "string"
    },
    "env": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Environment variables available to all steps"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/step" }
    }
  },
  "definitions": {
    "step": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$",
          "description": "Step identifier, used for referencing output in templates"
        },
        "type": {
          "type": "string",
          "description": "Step plugin type (e.g. http, shell)"
        },
        "config": {
          "type": "object",
          "description": "Plugin-specific configuration"
        },
        "retry": { "$ref": "#/definitions/retry" },
        "on_failure": {
          "type": "string",
          "enum": ["stop", "continue"],
          "default": "stop",
          "description": "Behaviour when the step fails"
        }
      }
    },
    "retry": {
      "type": "object",
      "properties": {
        "attempts": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "delay_seconds": {
          "type": "number",
          "minimum": 0,
          "default": 1
        }
      }
    }
  }
}
