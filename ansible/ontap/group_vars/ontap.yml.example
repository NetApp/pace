---
# Connection settings for all hosts in the "ontap" group.
# Copy this file to ontap.yml and fill in your values.
#
# WARNING: All values below are for illustration only.
# Replace svm_name, aggregate_name, volume_name, client_match, and
# credentials with values appropriate for your environment.
# In particular, client_match "0.0.0.0/0" allows ALL clients — restrict
# it to your actual client subnet in production.
#
# For production use, encrypt with:
#   ansible-vault encrypt group_vars/ontap.yml

ontap_hostname: "{{ inventory_hostname }}"
ontap_username: admin
ontap_password: "CHANGEME"
ontap_https: true
ontap_validate_certs: false   # supports self-signed certs; set true once CA-signed certs are in place

# Shared provisioning defaults
svm_name: vs0
volume_size: 100
volume_size_unit: mb
aggregate_name: aggr1

# NFS provisioning defaults (used by nfs_provision.yml)
volume_name: vol_nfs_test_01
client_match: "0.0.0.0/0"

# CIFS provisioning defaults (used by cifs_provision.yml)
# volume_name: vol_cifs_test_01         # uncomment to override for CIFS
share_name: cifs_share_test
share_comment: "Provisioned by Pace"
acl_user: Everyone
acl_permission: full_control
